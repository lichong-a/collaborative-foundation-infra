{
  "name": "collaborative-foundation-infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/verify.mjs",
    "audit:self": "node tools/cli.mjs check --repo . --policy manifest/governance.json --format json",
    "prepare:skills": "node scripts/prepare-skills.mjs",
    "prepare:teamai": "node scripts/teamai-runtime.mjs prepare",
    "upgrade:teamai": "node scripts/teamai-runtime.mjs upgrade"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "smol-toml": "1.8.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "teamai-cli": "0.24.0"
  }
}
